# In PRODUZIONE non serve impostare nulla: il client usa lo stesso indirizzo del server.
#
# Serve solo se tieni frontend e backend SEPARATI (es. frontend su Netlify,
# backend su Render). In quel caso metti qui l'URL pubblico del backend:
# VITE_SERVER_URL=https://cart-king.onrender.com
#
# In LOCALE su rete Wi-Fi (per giocare tra dispositivi in casa), metti l'IP del PC:
# VITE_SERVER_URL=http://192.168.1.42:3001
